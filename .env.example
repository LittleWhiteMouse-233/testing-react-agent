# Host configuration. External MCP services own their configuration independently.
TEST_AGENT_DEBUG=false
TEST_AGENT_CORS_ORIGINS=http://localhost:5173
TEST_AGENT_DATA_DIR=./data
TEST_AGENT_MCP_CONFIG_PATH=./mcp.json
TEST_AGENT_TOOL_CALL_TIMEOUT_SECONDS=120
TEST_AGENT_TOOL_CLEANUP_TIMEOUT_SECONDS=30
TEST_AGENT_SCREENSHOT_HISTORY_ROUNDS=3
TEST_AGENT_MODEL_CALL_MAX_ATTEMPTS=3
TEST_AGENT_MODEL_RESPONSE_MAX_ATTEMPTS=3

# Copy models.example.toml to models.toml. Each profile owns its API key and parameters.
# Relative paths are resolved from the repository root.
TEST_AGENT_MODEL_CONFIG_PATH=./models.toml

# Optional model selection: use a profile id from models.toml.
# Empty or unset routes use the first profile. Act and Judge share EXECUTION.
TEST_AGENT_PLANNING_MODEL_ID=
TEST_AGENT_EXECUTION_MODEL_ID=
