# Backend settings use ATV_ prefix to avoid collisions with system variables.
ATV_DEBUG=false
ATV_CORS_ORIGINS=http://localhost:5173
ATV_DATA_DIR=./data
ATV_ACTION_TIMEOUT_SECONDS=15
ATV_AGENT_HISTORY_MAX_TOKENS=8000

# Ordered model profiles. The first profile is the default for any activity
# without an explicit route. Keep credentials only in the local .env file.
LLM_PROFILES=[{"id":"default","mode":"scripted","model":"deterministic","timeout_seconds":60}]

# Optional activity routes. Each value must reference an id in LLM_PROFILES.
ATV_PLANNING_MODEL_ID=
ATV_ACT_MODEL_ID=
ATV_JUDGE_MODEL_ID=

# Example real profile:
# LLM_PROFILES=[{"id":"planner","mode":"real","base_url":"https://example.com/v1","api_key":"replace-me","model":"your-planning-model","temperature":0,"timeout_seconds":60,"save_raw_response":false},{"id":"vision","mode":"real","base_url":"https://example.com/v1","api_key":"replace-me","model":"your-multimodal-tool-model","temperature":0,"timeout_seconds":60,"save_raw_response":false}]
# ATV_PLANNING_MODEL_ID=planner
# ATV_ACT_MODEL_ID=vision
# ATV_JUDGE_MODEL_ID=vision

# fake-tv is always available. Set a serial to additionally register ADB.
ADB_PATH=adb
ADB_SERIAL=
