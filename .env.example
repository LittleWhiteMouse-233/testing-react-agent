# Backend settings use ATV_ prefix to avoid collisions with system variables.
ATV_DEBUG=false
ATV_CORS_ORIGINS=http://localhost:5173
ATV_DATA_DIR=./data
ATV_ACTION_TIMEOUT_SECONDS=15
ATV_AGENT_HISTORY_MAX_TOKENS=8000

# scripted is deterministic and requires no network or credentials.
LLM_MODE=scripted

# Required when LLM_MODE=real. The endpoint must support multimodal chat
# completions, strict response_format=json_schema, function calling, and
# simultaneous tools plus structured output.
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=replace-me
LLM_MODEL=your-multimodal-model
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_SAVE_RAW_RESPONSE=false

# fake-tv is always available. Set a serial to additionally register ADB.
ADB_PATH=adb
ADB_SERIAL=
